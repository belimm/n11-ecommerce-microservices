# Copy this file to .env.production on EC2. Never commit real secret values.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=0.0.1-SNAPSHOT

DB_URL=jdbc:postgresql://your-rds-endpoint.eu-west-1.rds.amazonaws.com:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

IYZICO_API_KEY=change-me
IYZICO_SECRET_KEY=change-me
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

PRODUCT_SEED_ENABLED=false
STOCK_SEED_ENABLED=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_SECURITY_ALLOW_EMBEDDING=true
